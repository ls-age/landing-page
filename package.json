{
  "name": "@ls-age/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Lukas Hechenberger's website and blog (lukashechenberger.com)",
  "license": "UNLICENSED",
  "author": "Lukas Hechenberger <npm@ls-age.com> (https://ls-age.com/)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changesets:publish": "for dir in packages/*; do (cd \"$dir\" && bun publish || exit 0); done && changeset git-tag",
    "changesets:version": "changeset version && bun install",
    "check": "turbo run check",
    "check:format": "prettier --check .",
    "check:knip": "knip-bun --reporter github-actions",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "ignore-sync": "ignore-sync .",
    "knip": "knip-bun",
    "lint": "turbo run lint",
    "prepare": "bun --bun toolsync prepare --config toolsync.json && ignore-sync .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@toolsync/builtin": "^0.6.4",
    "@toolsync/cli": "0.4.5",
    "@workspace/toolsync-plugin": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "ignore-sync": "^8.0.0",
    "knip": "^6.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": "24.x"
  }
}
