{
  "tasks": {
    "//#check:knip": {},
    "check": {
      "dependsOn": [
        "//#check:knip",
        "//#check:format",
        "check:types"
      ]
    },
    "build": {
      "env": [
        "BLOB_READ_WRITE_TOKEN",
        "DATABASE_URL",
        "GITHUB_TOKEN",
        "PAYLOAD_SECRET"
      ],
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "//#check:format": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check:types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        "test:transit"
      ]
    },
    "test:transit": {
      "dependsOn": [
        "^test:transit"
      ]
    }
  },
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui"
}
