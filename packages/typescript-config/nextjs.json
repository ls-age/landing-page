{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "preserve",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true
  }
}
