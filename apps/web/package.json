{
  "name": "@ls-age/web",
  "version": "0.0.0",
  "private": true,
  "description": "Lukas Hechenberger's website and blog (lukashechenberger.com)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:payload": "bun x-payload generate:types && bun x-payload generate:importmap",
    "check:types": "next typegen && tsc --noEmit",
    "dev": "next dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "migration:create": "BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder_placeholder bun x-payload migrate:create",
    "migration:deploy": "bun x-payload migrate",
    "start": "next start",
    "test": "bun test src",
    "x-payload": "bun --bun payload --disable-transpile"
  },
  "dependencies": {
    "@payloadcms/db-vercel-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@workspace/ui": "workspace:*",
    "graphql": "^16.14.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "shiki": "^4.5.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.11",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "schema-dts": "^2.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
