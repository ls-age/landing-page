{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["build:payload"]
    },
    "check:types": {
      "dependsOn": ["^build", "build:payload"]
    },
    "build:payload": {
      "outputs": ["src/__generated__/payload-types.ts"],
      "passThroughEnv": ["BLOB_READ_WRITE_TOKEN", "DATABASE_URL", "PAYLOAD_SECRET"]
    },
    "build": {
      "dependsOn": ["^build", "build:payload"],
      "passThroughEnv": [
        "BLOB_READ_WRITE_TOKEN",
        "DATABASE_URL",
        "GITHUB_TOKEN",
        "PAYLOAD_SECRET",
        "VERCEL_ENV"
      ]
    }
  }
}
